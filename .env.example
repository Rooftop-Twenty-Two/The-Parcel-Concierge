# The Parcel Concierge, environment variables.
#
# Copy to .env.local for development. None of these are required to run the
# site: with no Shopify credentials it serves the fixture catalogue, shows a
# preview banner and sets noindex.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://theparcelconcierge.com

# Serve the holding page instead of the site. Every page request is
# rewritten to /coming-soon and the whole site goes noindex. Set this in the
# hosting dashboard and remove it to go live: it needs no deploy either way.
SITE_COMING_SOON=

# Force noindex without the holding page, for an environment that is live
# but not launched.
SITE_NOINDEX=

# --- Shopify Storefront (public scoped, read only) --------------------------
# Safe to reach the client. Setting both switches the site off fixtures.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-07

# --- Shopify Admin (SERVER ONLY) --------------------------------------------
# Used by scripts/ingest only. Nothing under src/ reads this, and it must
# never reach a client bundle. Custom app token, scoped to:
#   write_products, read_products, write_metaobject_definitions
SHOPIFY_ADMIN_TOKEN=

# Shared secret from the Shopify webhook subscription. Without it the
# revalidation endpoint refuses every request, which is the correct
# behaviour: an unverified endpoint that triggers rebuilds is a free
# denial-of-service for anyone who finds the URL.
SHOPIFY_WEBHOOK_SECRET=

# --- Trustpilot -------------------------------------------------------------
# Without these the stars fall back to the figures verified in the June 2026
# review (5.0 from 81 reviews) rather than rendering nothing.
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=

# --- Analytics --------------------------------------------------------------
# With none of these set, no tag loads at all. The purchase event fires on
# the Shopify side of the checkout handoff, never here: see docs/analytics.md.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Wine club -------------------------------------------------------------
# Subscriptions are Shopify selling plans and need a subscription app on the
# store. Without the group id the club page renders in full and says
# sign-ups are not open, rather than showing a button that cannot work.
# See docs/wine-club.md.
NEXT_PUBLIC_WINE_CLUB_SELLING_PLAN_GROUP=
WINE_CLUB_PLAN_MONTHLY=
WINE_CLUB_PLAN_QUARTERLY=
WINE_CLUB_PLAN_TWO_MONTHLY=

# --- Forms ------------------------------------------------------------------
# Where corporate enquiries and newsletter signups are posted. Without them
# submissions are logged server side and the request still succeeds, which
# is a deliberate trade for the preview build and a launch blocker for
# production.
CORPORATE_ENQUIRY_WEBHOOK=
CORPORATE_ENQUIRY_EMAIL=
NEWSLETTER_WEBHOOK=
# Corporate gifting: gates campaign activation and the admin dashboard
CORPORATE_ADMIN_KEY=
