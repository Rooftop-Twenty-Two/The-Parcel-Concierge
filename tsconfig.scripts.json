{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The Node type-stripping runtime resolves imports at runtime, so
    // relative imports must carry their .ts extension. The Next build uses
    // a bundler resolver and must not, hence the separate project.
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
